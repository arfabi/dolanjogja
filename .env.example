# =====================================================
# DolanJogja — Environment Configuration Example
# Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# =====================================================

# ── Database ──────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=dolanjogja

# ── Azure OpenAI ──────────────────────────────────────
# Nama resource Azure Anda (bagian dari URL endpoint)
AZURE_RESOURCE=your-azure-resource-name

# API Key dari Azure Portal → OpenAI resource → Keys and Endpoint
AZURE_API_KEY=your_azure_openai_api_key_here

# Versi API Azure OpenAI
AZURE_API_VERSION=2024-08-01-preview

# Nama deployment model di Azure OpenAI Studio
AZURE_DEPLOYMENT_GPT4O=gpt-4o
AZURE_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini

# ── App ───────────────────────────────────────────────
# Nilai: development | production
APP_ENV=production

# Debug mode (true hanya di lokal/development)
APP_DEBUG=false

# CORS origin — gunakan domain frontend Anda di production (contoh: https://dolanjogja.com)
CORS_ALLOW_ORIGIN=*
